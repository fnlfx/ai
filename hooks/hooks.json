{
  "description": "FunnelFox: save each design and its structure index after funnel_design_get; run the screenshot and walk scripts without a permission prompt.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [{ "type": "command", "if": "Bash(node *)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/approve-shot.mjs\"", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__.*__funnel_design_get$",
        "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/design-get.mjs\"", "timeout": 60 }]
      }
    ]
  }
}
